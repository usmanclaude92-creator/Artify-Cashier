{
  "name": "Artify Cashier — Petty Cash Management",
  "short_name": "Artify Cashier",
  "id": "com.artify.cashier",
  "description": "Enterprise Android petty cash cashier app with AI OCR bill scanning, VAT tracking, supervisor approvals, and PDF closure reports.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait-primary",
  "background_color": "#020617",
  "theme_color": "#020617",
  "icons": [
    {
      "src": "/icon-192.svg",
      "sizes": "192x192",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    },
    {
      "src": "/icon-512.svg",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "New Receipt Scan",
      "short_name": "Scan Bill",
      "description": "Scan physical receipt with camera OCR",
      "url": "/?action=add_transaction",
      "icons": [{ "src": "/icon-192.svg", "sizes": "192x192" }]
    },
    {
      "name": "Request Funds",
      "short_name": "Request Float",
      "description": "Submit a petty cash top-up request",
      "url": "/?action=request_funds",
      "icons": [{ "src": "/icon-192.svg", "sizes": "192x192" }]
    }
  ],
  "related_applications": [
    {
      "platform": "play",
      "id": "com.artify.cashier"
    }
  ]
}
